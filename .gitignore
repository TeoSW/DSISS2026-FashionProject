# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- secrets / local config ---
.env
kaggle.json

# --- datasets and model output (big, regenerable) ---
data/
# fine-tuned checkpoints, ~600MB each. A trailing comment on this line would be
# part of the pattern, not a comment: git only honours # at the start of a line.
models/
*.zip
*.part
cutout.png

# --- neo4j docker volume ---
neo4j_data/

# --- editors / tooling ---
.idea/
.vscode/
.claude/settings.local.json
# agent skills are installed per machine, in ~/.claude/skills, and are nobody
# else's business: a copy dropped in here is 2.5MB of vendored third-party
# files that would otherwise ride along in the next commit
.claude/skills/
.gemini/
.21st/

# --- os ---
Thumbs.db
.DS_Store

# local one-click launcher, machine-specific paths
start.bat
