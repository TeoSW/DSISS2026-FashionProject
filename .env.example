# Copy this file to .env and put your real password in it. .env is gitignored,
# docker-compose.yml and config.py both read it, so they cannot drift apart.
NEO4J_URI=bolt://localhost:7687

# Neo4j Community has exactly one account, the built-in "neo4j". Multiple users
# and CREATE USER are Enterprise features, so do not change this name: the
# server refuses to boot with "Invalid admin username, it must be neo4j".
NEO4J_USER=neo4j
NEO4J_PASSWORD=parola123

# Any Hugging Face CLIP checkpoint. FashionCLIP is the default because it wins
# by 10.4 points on the Fashionpedia validation split; openai/clip-vit-base-patch32
# is the baseline the evaluation compares against.
CLIP_MODEL=patrickjohncyh/fashion-clip
